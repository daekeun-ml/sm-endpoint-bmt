# SageMaker Endpoint Configuration
# Copy this file to .env and fill in your values

# Endpoint Configuration
ENDPOINT_NAME=

# Instance Configuration
INSTANCE_TYPE=ml.g6.48xlarge
INSTANCE_COUNT=1

# AWS Configuration
AWS_REGION=us-east-1
SAGEMAKER_ROLE=

# Container Configuration
# LMI 태그입니다. vLLM DLC 를 쓸 때는 이 값을 비워 두세요 —
# create_endpoint.py 가 config 의 env 키로 엔진을 판별해 맞는 기본 태그로 바꿉니다.
CONTAINER_VERSION=0.36.0-lmi26.0.0-cu130

# Serving config file. config/vllm/ (SM_VLLM_*) 또는 config/lmi/ (OPTION_*) 중 하나를 가리킵니다.
VLLM_CONFIG_FILE=config/vllm/gemma-4-E4B.json

# Deployment Configuration
HEALTH_CHECK_TIMEOUT=1800
